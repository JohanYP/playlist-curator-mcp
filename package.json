{
  "name": "playlist-curator-mcp",
  "version": "0.1.0",
  "description": "MCP server that adds curation routines on top of Navidrome — daily ephemeral playlists, weekly auto-curated radio, and YouTube download-on-miss. Complementary to navidrome-mcp.",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "playlist-curator-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "lint": "eslint src tests --ext .ts --max-warnings=0",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "navidrome",
    "subsonic",
    "music",
    "playlist",
    "curator",
    "yt-dlp",
    "youtube",
    "assistant"
  ],
  "author": "JohanYP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohanYP/playlist-curator-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/JohanYP/playlist-curator-mcp/issues"
  },
  "homepage": "https://github.com/JohanYP/playlist-curator-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "better-sqlite3": "^12.6.2",
    "croner": "^9.0.0",
    "subsonic-api": "^3.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
